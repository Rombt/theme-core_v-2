parameters:
    level: max

    paths:
        - core
        - tests

    tmpDir: .cache/phpstan

    ignoreErrors:
        -
            message: '#Instanceof between .*ServiceDefinitionProviderInterface.* will always evaluate to true#'
            path: core/Bootstrap/Bootstrappers/CompositionBootstrapper.php

        # Runtime safety guard is intentional (pipeline accepts mixed sources in future extensions)
        -
            message: '#Instanceof between .*StageInterface.* will always evaluate to true#'
            path: core/Runtime/Pipeline/PipelineExecutor.php
