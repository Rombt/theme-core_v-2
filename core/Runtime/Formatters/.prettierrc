{
    "singleQuote": true,
    "useTabs": false,
    "tabWidth": 4,
    "printWidth": 180,
    "endOfLine": "lf",
    "plugins": ["@prettier/plugin-php"],
    "overrides": [
        {
            "files": "*.php",
            "options": {
                "parser": "php",
                "braceStyle": "psr-2",
                "trailingCommaPHP": false,
                "singleQuote": true
            }
        }
    ]
}
