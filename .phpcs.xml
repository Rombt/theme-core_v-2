<?xml version="1.0"?>
<ruleset name="WordPressTheme">

    <description>
        Custom ruleset for theme-core v-2 project
        but it are not finished
    </description>

    <!-- Проверяем только PHP -->
    <arg name="extensions" value="php" />

    <rule ref="PSR12">
        <exclude name="PSR12.Files.FileHeader.HeaderPosition" />
    </rule>

    <!-- Исключеаем обход этих каталогов-->
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>./app/gulp/*</exclude-pattern>
    <exclude-pattern>assets/js/*</exclude-pattern>
    <exclude-pattern>assets/css/*</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>


</ruleset>
